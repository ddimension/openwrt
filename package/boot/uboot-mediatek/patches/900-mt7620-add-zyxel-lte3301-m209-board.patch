--- a/board/mediatek/mt7620-lte3301-m209/mt7620-lte3301-m209.env
+++ b/board/mediatek/mt7620-lte3301-m209/mt7620-lte3301-m209.env
@@ -0,0 +1,70 @@
+# U-Boot environment for ZyXEL LTE3301-M209/Q222
+#
+# Flash layout:
+#   0x000000  u-boot (SPL + proper, 192K)
+#   0x030000  u-boot-env (64K)
+#   0x040000  firmware (FIT + squashfs, "denx,fit")
+#   0xFF0000  config (MAC + WiFi EEPROM, do not touch!)
+
+bootdelay=3
+baudrate=115200
+bootcmd=bootm 0xbc040000 || run autoflash
+bootargs=console=ttyS0,115200 rootfstype=squashfs
+
+loadaddr=0x80010000
+netloadaddr=0x81000000
+
+# Sanity magics checked before any flash erase/write (see chk_* below):
+#   spl_magic = first word of the bootloader (SPL entry, offset 0)
+#   fit_magic = FDT/FIT magic d00dfeed, little-endian in memory
+# A download is only written if it is the right kind of image; tftpboot
+# already guarantees the transfer was complete (it fails otherwise).
+spl_magic=1000013f
+fit_magic=edfe0dd0
+chk_factory=test "$filesize" = "ff0000" && setexpr v *$netloadaddr + 0 && test "$v" = "$spl_magic" && setexpr a $netloadaddr + 0x40000 && setexpr v *$a + 0 && test "$v" = "$fit_magic"
+
+# Never auto-boot what the DHCP server offers - netboot loads its own
+# initramfs FIT explicitly.
+autoload=no
+
+# Static defaults for the recovery LAN; dhcp overrides them on success
+# (netboot runs dhcp first, then tftpboot with whatever is set).
+ipaddr=192.168.123.254
+serverip=192.168.123.123
+tftpsrcp=69
+tftpdstp=69
+
+# Hold reset or WPS at boot (board.c points bootcmd here): fetch the whole
+# factory image over TFTP and rewrite the flash, then reboot. No read-back
+# verify - the 16 MiB image leaves no second RAM window below the U-Boot
+# relocation area; skip-identical and the FIT hashes guard the next boot.
+autoinstall=tftpboot $netloadaddr factory.bin && run chk_factory && sf probe && sf update $netloadaddr 0x0 $filesize && reset || echo "autoinstall: image incomplete or not a bootloader - flash skipped"
+
+# Partitions (flash offsets, kseg1: +0xbc000000)
+fw_addr=0x40000
+chk_fw=setexpr v *$netloadaddr + 0 && test "$v" = "$fit_magic"
+chk_uboot=setexpr v *$netloadaddr + 0 && test "$v" = "$spl_magic"
+fw_size=0xfb0000
+
+# Automatic fallback: boot the OpenWrt initramfs FIT from TFTP. Runs
+# entirely from RAM (SSH up, then sysupgrade/scp a new image).
+netboot=dhcp; tftpboot $netloadaddr zyxel_lte3301-m209-initramfs-kernel.bin && bootm $netloadaddr
+
+# Installation: when the firmware partition has no valid FIT (fresh
+# device after the bootloader was installed as a kernel), auto-flash
+# the firmware and then the bootloader from TFTP. Ordered for safety:
+# the firmware is written and verified first, the bootloader last, so
+# an interrupted run leaves jboot (or the old bootloader) intact and
+# the device recoverable. Each write is verified with a read-back and
+# a byte compare before the reset.
+# The read-back buffer is derived from the image size instead of being
+# hardcoded: a fixed address silently starts to overlap the download
+# buffer once the firmware grows, and the compare would then pass
+# against itself.
+autoflash=tftpboot $netloadaddr firmware-sysupgrade.bin && run chk_fw && sf probe && sf update $netloadaddr $fw_addr $filesize && setexpr vfyaddr $netloadaddr + $filesize && sf read $vfyaddr $fw_addr $filesize && cmp.b $netloadaddr $vfyaddr $filesize && tftpboot $netloadaddr uboot.bin && run chk_uboot && sf update $netloadaddr 0x0 $filesize && setexpr vfyaddr $netloadaddr + $filesize && sf read $vfyaddr 0x0 $filesize && cmp.b $netloadaddr $vfyaddr $filesize && reset || echo "autoflash: image incomplete or not a bootloader/firmware - flash skipped"
+
+# Manual TFTP recovery of the whole firmware partition (FIT + rootfs in
+# one file - the rootfs offset depends on the padded FIT size, so there
+# is no fixed rootfs address to flash separately):
+#   run flashrecovery
+flashrecovery=dhcp && tftpboot $netloadaddr firmware-sysupgrade.bin && sf probe && sf update $netloadaddr $fw_addr $filesize && reset
--- a/arch/mips/dts/mediatek,mt7620-lte3301-m209.dts
+++ b/arch/mips/dts/mediatek,mt7620-lte3301-m209.dts
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ZyXEL LTE3301-M209 (MT7620N)
+ *
+ * Based on mt7620-rfb.dts (MediaTek Inc.).
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include "mt7620.dtsi"
+
+/ {
+	compatible = "zyxel,lte3301-m209", "mediatek,mt7620-soc";
+	model = "ZyXEL LTE3301-M209";
+
+	aliases {
+		serial0 = &uartlite;
+		spi0 = &spi0;
+	};
+
+	chosen {
+		stdout-path = &uartlite;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_power: power {
+			label = "power";
+			gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
+		};
+
+		wan {
+			label = "wan";
+			gpios = <&gpio1 14 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		/* Pads 40-43 as gpio-LEDs like on the proven reference
+		 * (defined levels, no EPHY mode - the ESW would otherwise
+		 * drive possible modem strap lines). Pin 72 is deliberately
+		 * left untouched (unclaimed on the reference). */
+		mobile_green {
+			label = "mobile_green";
+			gpios = <&gpio2 0 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		mobile_red {
+			label = "mobile_red";
+			gpios = <&gpio2 1 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		mobile_lte {
+			label = "mobile_lte";
+			gpios = <&gpio2 2 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		switch_led {
+			label = "switch";
+			gpios = <&gpio2 3 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+	};
+
+	options {
+		u-boot {
+			/* Power LED on as soon as U-Boot runs (the kernel takes it over) */
+			boot-led = <&led_power>;
+		};
+	};
+};
+
+&uartlite {
+	status = "okay";
+};
+
+&pinctrl {
+	state_default: pin_state {
+		uart {
+			groups = "uartf";
+			function = "gpio";
+		};
+
+		/*
+		 * "ephy led" is bit 15 of GPIO1_MODE: without it the ESW
+		 * drives pads 40-44, which blinks the front LEDs on LAN
+		 * traffic and touches the modem strap lines. "wled" (bit 13)
+		 * frees pad 72 the same way the vendor loader does, although
+		 * nothing here drives that pad.
+		 *
+		 * "wdt rst" is the bits 21:22 field. The vendor loader leaves
+		 * it at 0 (reset output on pad 17), we select gpio like the
+		 * proven reference firmware does - the extra board LEDs only
+		 * work with it, verified on hardware.
+		 */
+		led {
+			groups = "ephy led", "wled", "wdt rst";
+			function = "gpio";
+		};
+
+		/*
+		 * GPIO 1 is the reset button. The pad comes up in gpio mode
+		 * after reset, selecting the group just stops that from being
+		 * an accident.
+		 */
+		button {
+			groups = "i2c";
+			function = "gpio";
+		};
+	};
+};
+
+&spi0 {
+	status = "okay";
+	num-cs = <2>;
+
+	spi-flash@0 {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "jedec,spi-nor";
+		spi-max-frequency = <25000000>;
+		reg = <0>;
+	};
+};
+
+&eth {
+	status = "okay";
+
+	/*
+	 * Internal 5-port switch (4x FE-LAN + WAN, portmap "llllw"); the
+	 * EPHY LED pads (40-44) belong in GPIO mode, see pin_state above.
+	 * No "mediatek,poll-link-phy" here: only the mt7628 driver reads
+	 * that property, the mt7620 one takes PHY polling from the
+	 * phy-addr of a port4/port5 subnode.
+	 */
+};
