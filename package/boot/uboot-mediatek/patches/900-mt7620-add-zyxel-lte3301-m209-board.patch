--- a/board/mediatek/mt7620-lte3301-m209/board.c
+++ b/board/mediatek/mt7620-lte3301-m209/board.c
@@ -0,0 +1,397 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ZyXEL LTE3301-M209/Q222 — board init
+ *
+ * The device MAC lives in the vendor config partition (0xFF0000) at
+ * different offsets per hardware variant:
+ *   M209: 0xe2a8 (Q222 stores the serial number there instead)
+ *   Q222: 0xe07c
+ * Read both candidates and set ethaddr from the first plausible one
+ * (unicast, not all-zero/all-ff). If neither is valid, the network
+ * stack falls back to a random MAC as before. The environment is only
+ * set in RAM — the env partition stays untouched.
+ *
+ * Additionally the STAG/CSXF record chain in the config partition is
+ * parsed (importer ported from the jboot_config_read userspace tool)
+ * and handed to the kernel as environment variables:
+ *   jboot_model  (record 0x20, "LTE3301")
+ *   jboot_serial (record 0x12, "S..."; falls back to 0x10 "ZXL...")
+ *   jboot_serial_zxl (record 0x10)
+ *   jboot_build  (record 0x18, production date)
+ *   jboot_subtype ("m209"/"q222", detected via the known MAC offsets)
+ * These are persisted (env_save) only when they changed.
+ */
+
+#include <env.h>
+#include <spi_flash.h>
+#include <dm/uclass.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define JBOOT_CFG_OFFSET	0xff0000
+#define MAC_OFFSET_M209		0xe2a8
+#define MAC_OFFSET_Q222		0xe07c
+
+static bool is_valid_mac(const u8 *mac)
+{
+	int i;
+
+	if (mac[0] & 1)		/* multicast/broadcast bit */
+		return false;
+
+	for (i = 0; i < 6; i++) {
+		if (mac[i])
+			break;
+	}
+	if (i == 6)		/* all zero */
+		return false;
+
+	for (i = 0; i < 6; i++) {
+		if (mac[i] != 0xff)
+			break;
+	}
+	if (i == 6)		/* all 0xff */
+		return false;
+
+	return true;
+}
+
+static int read_config_mac(u8 *mac)
+{
+	struct udevice *dev;
+	struct spi_flash *flash;
+	int ret;
+
+	ret = uclass_get_device(UCLASS_SPI_FLASH, 0, &dev);
+	if (ret)
+		return ret;
+	flash = dev_get_uclass_priv(dev);
+
+	ret = spi_flash_read(flash, JBOOT_CFG_OFFSET + MAC_OFFSET_M209, 6, mac);
+	if (!ret && is_valid_mac(mac))
+		return 0;
+
+	ret = spi_flash_read(flash, JBOOT_CFG_OFFSET + MAC_OFFSET_Q222, 6, mac);
+	if (!ret && is_valid_mac(mac))
+		return 0;
+
+	return -1;
+}
+
+/* --- jboot config record chain importer -------------------------------- */
+#define JBOOT_CFG_SIZE	0x10000
+#define STAG_SIZE		16
+#define STAG_MAGIC		0x2b24
+#define STAG_ID			0x02
+#define CSXF_SIZE		16
+#define CSXF_MAGIC		0x5343
+#define DHDR_SIZE		6
+#define DHDR_UNKNOWN		0x8000
+#define DHDR_EEPROM		0xf5
+#define DHDR_CONFIG		0x42
+#define REC_ID_MAC		0x30
+#define REC_ID_MODEL		0x20
+#define REC_ID_SERIAL		0x10
+#define REC_ID_SN		0x12
+#define REC_ID_DATE		0x18
+
+struct jboot_stag_header {
+	u8 cmark;
+	u8 id;
+	u16 magic;
+	u32 time_stamp;
+	u32 image_length;
+	u16 image_checksum;
+	u16 tag_checksum;
+};
+
+struct jboot_csxf_header {
+	u16 magic;
+	u16 checksum;
+	u32 body_length;
+	u8 body_encoding;
+	u8 reserved[3];
+	u32 raw_length;
+};
+
+struct jboot_data_header {
+	u8 id;
+	u8 type;
+	u16 unknown;
+	u16 length;
+	u8 data[];
+};
+
+/*
+ * Byte-wise jboot checksum: the record chain contains odd-length
+ * records, so every field read must be alignment-safe (MIPS faults on
+ * unaligned u16/u32 loads - the x86-only userspace tool never noticed).
+ */
+static u16 get_le16(const u8 *p)
+{
+	return p[0] | (p[1] << 8);
+}
+
+static u32 get_le32(const u8 *p)
+{
+	return p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24);
+}
+
+static u16 jboot_checksum(u16 start_val, const u8 *data, int size)
+{
+	u32 counter = start_val;
+	const u8 *ptr = data;
+
+	while (size > 1) {
+		counter += get_le16(ptr);
+		ptr += 2;
+		while (counter >> 16)
+			counter = (u16)counter + (counter >> 16);
+		size -= 2;
+	}
+	if (size > 0) {
+		counter += *ptr;
+		counter -= 0xff;
+	}
+	while (counter >> 16)
+		counter = (u16)counter + (counter >> 16);
+	return counter;
+}
+
+static void copy_rec_string(const u8 *data, int len, char *out, int out_size)
+{
+	int n = len < out_size - 1 ? len : out_size - 1;
+
+	memcpy(out, data, n);
+	out[n] = 0;
+}
+
+static int import_jboot_config(u8 *mac, char *subtype, int subtype_size,
+			       char *model, int model_size,
+			       char *serial_zxl, int zxl_size,
+			       char *serial_sn, int sn_size,
+			       char *build_date, int date_size)
+{
+	struct udevice *dev;
+	struct spi_flash *flash;
+	struct jboot_csxf_header *csxf;
+	struct jboot_data_header *rec;
+	u8 stag_pat[4] = { STAG_ID, STAG_ID, STAG_MAGIC & 0xff,
+			   STAG_MAGIC >> 8 };
+	u8 *buf, *p, *end;
+	u8 probe[6];
+	u32 body_len;
+	u16 stored_cs;
+	int ret;
+
+	ret = uclass_get_device(UCLASS_SPI_FLASH, 0, &dev);
+	if (ret)
+		return ret;
+	flash = dev_get_uclass_priv(dev);
+
+	buf = malloc(JBOOT_CFG_SIZE);
+	if (!buf)
+		return -1;
+
+	if (spi_flash_read(flash, JBOOT_CFG_OFFSET, JBOOT_CFG_SIZE, buf)) {
+		free(buf);
+		return -1;
+	}
+
+	/*
+	 * Locate the checksum-verified STAG header. Stop early enough that
+	 * the CSXF header behind it is still inside the buffer.
+	 */
+	for (p = buf; p + STAG_SIZE + CSXF_SIZE <= buf + JBOOT_CFG_SIZE; p++) {
+		if (memcmp(p, stag_pat, 4))
+			continue;
+		if (get_le16(p + 14) ==
+		    (u16)~jboot_checksum(0, p, STAG_SIZE - 2))
+			break;
+	}
+	if (p + STAG_SIZE + CSXF_SIZE > buf + JBOOT_CFG_SIZE) {
+		free(buf);
+		return -1;
+	}
+
+	/* verify the CSXF header right behind the STAG */
+	csxf = (struct jboot_csxf_header *)(p + STAG_SIZE);
+	if (get_le16((u8 *)csxf) != CSXF_MAGIC) {
+		free(buf);
+		return -1;
+	}
+	body_len = get_le32((u8 *)csxf + 12);
+	if (body_len > JBOOT_CFG_SIZE - (u32)((u8 *)csxf - buf) - CSXF_SIZE) {
+		free(buf);
+		return -1;
+	}
+	stored_cs = get_le16((u8 *)csxf + 2);
+	*((u8 *)csxf + 2) = 0;
+	*((u8 *)csxf + 3) = 0;
+	if (stored_cs !=
+	    (u16)~jboot_checksum(0, (u8 *)csxf, body_len + CSXF_SIZE)) {
+		free(buf);
+		return -1;
+	}
+
+	/* walk the record chain */
+	end = buf + JBOOT_CFG_SIZE;
+	p += STAG_SIZE + CSXF_SIZE;
+	while (p + DHDR_SIZE <= end) {
+		rec = (struct jboot_data_header *)p;
+		if (get_le16(p + 2) != DHDR_UNKNOWN ||
+		    (p[1] != DHDR_EEPROM && p[1] != DHDR_CONFIG)) {
+			p++;
+			continue;
+		}
+		if (p + DHDR_SIZE + get_le16(p + 4) > end)
+			break;
+		switch (p[0]) {
+		case REC_ID_MAC:
+			if (get_le16(p + 4) >= 6)
+				memcpy(mac, p + DHDR_SIZE, 6);
+			break;
+		case REC_ID_MODEL:
+			copy_rec_string(p + DHDR_SIZE, get_le16(p + 4), model,
+					model_size);
+			break;
+		case REC_ID_SERIAL:
+			copy_rec_string(p + DHDR_SIZE, get_le16(p + 4),
+					serial_zxl, zxl_size);
+			break;
+		case REC_ID_SN:
+			copy_rec_string(p + DHDR_SIZE, get_le16(p + 4), serial_sn,
+					sn_size);
+			break;
+		case REC_ID_DATE:
+			copy_rec_string(p + DHDR_SIZE, get_le16(p + 4),
+					build_date, date_size);
+			break;
+		}
+		p += DHDR_SIZE + get_le16(p + 4);
+	}
+
+	/*
+	 * Variant detection: the record MAC must match the data at one of
+	 * the known fixed offsets (M209 0xe2a8, Q222 0xe07c).
+	 */
+	if (is_valid_mac(mac)) {
+		if (!spi_flash_read(flash, JBOOT_CFG_OFFSET + MAC_OFFSET_M209,
+				    6, probe) && !memcmp(probe, mac, 6))
+			copy_rec_string((const u8 *)"m209", 4, subtype,
+					subtype_size);
+		else if (!spi_flash_read(flash,
+					 JBOOT_CFG_OFFSET + MAC_OFFSET_Q222,
+					 6, probe) && !memcmp(probe, mac, 6))
+			copy_rec_string((const u8 *)"q222", 4, subtype,
+					subtype_size);
+	}
+
+	free(buf);
+	return 0;
+}
+
+static void env_set_if_changed(const char *name, const char *val, bool *dirty)
+{
+	const char *cur = env_get(name);
+
+	if (!cur || strcmp(cur, val)) {
+		env_set(name, val);
+		*dirty = true;
+	}
+}
+
+/*
+ * The reset button is GPIO 1 and WPS is GPIO 2 (bank 0 data at 0xb0000620,
+ * both active low); the "i2c" pin group already puts them in GPIO mode.
+ * Holding either one at boot requests a full network reinstall, the same
+ * thing the RAM autoinstall image does unconditionally.
+ */
+#define LTE3301_GPIO0_DATA	0xb0000620
+#define LTE3301_GPIO0_DIR	0xb0000624
+#define LTE3301_BTN_MASK	((1u << 1) | (1u << 2))	/* reset | WPS */
+
+static bool install_button_held(void)
+{
+	void __iomem *dir = (void __iomem *)LTE3301_GPIO0_DIR;
+	void __iomem *data = (void __iomem *)LTE3301_GPIO0_DATA;
+
+	writel(readl(dir) & ~LTE3301_BTN_MASK, dir);	/* reset+WPS = inputs */
+	/* active low: pressed when either bit reads 0 */
+	return (readl(data) & LTE3301_BTN_MASK) != LTE3301_BTN_MASK;
+}
+
+int board_late_init(void)
+{
+	u8 mac[6], walker_mac[6] = { 0 };
+	char subtype[8] = { 0 }, model[32] = { 0 };
+	char serial_zxl[32] = { 0 }, serial_sn[32] = { 0 };
+	char build_date[32] = { 0 };
+	bool dirty = false;
+
+	if (!eth_env_get_enetaddr("ethaddr", mac)) {
+		if (!read_config_mac(mac))
+			eth_env_set_enetaddr("ethaddr", mac);
+	}
+
+	/*
+	 * Import the vendor config records and pass them to the kernel via
+	 * the environment (readable with fw_printenv). Persisted only when
+	 * something changed, to avoid unnecessary flash writes.
+	 */
+	if (!import_jboot_config(walker_mac, subtype, sizeof(subtype),
+				 model, sizeof(model),
+				 serial_zxl, sizeof(serial_zxl),
+				 serial_sn, sizeof(serial_sn),
+				 build_date, sizeof(build_date))) {
+		if (is_valid_mac(walker_mac) &&
+		    (!eth_env_get_enetaddr("ethaddr", mac) ||
+		     memcmp(mac, walker_mac, 6)))
+			eth_env_set_enetaddr("ethaddr", walker_mac);
+		if (subtype[0])
+			env_set_if_changed("jboot_subtype", subtype, &dirty);
+		if (model[0])
+			env_set_if_changed("jboot_model", model, &dirty);
+		if (serial_sn[0])
+			env_set_if_changed("jboot_serial", serial_sn, &dirty);
+		else if (serial_zxl[0])
+			env_set_if_changed("jboot_serial", serial_zxl, &dirty);
+		if (serial_zxl[0])
+			env_set_if_changed("jboot_serial_zxl", serial_zxl,
+					   &dirty);
+		if (build_date[0])
+			env_set_if_changed("jboot_build", build_date, &dirty);
+	}
+
+#ifndef CONFIG_SPL_BUILD
+	/*
+	 * Persist the environment when the jboot values changed, or when
+	 * the default environment is in use (the flash env was unreadable):
+	 * then bootcmd and friends are written so that the next boot
+	 * imports a valid env instead of showing a bad-CRC warning.
+	 * Note: env_init() marks the fallback default env as ENV_VALID,
+	 * so GD_FLG_ENV_DEFAULT is the only reliable indicator.
+	 *
+	 * Skipped for the RAM-executed install variant (ENV_IS_NOWHERE):
+	 * that one runs while the old vendor layout is still in flash and
+	 * must not write anything before the install itself does.
+	 */
+	if (!IS_ENABLED(CONFIG_ENV_IS_NOWHERE) &&
+	    (dirty || (gd->flags & GD_FLG_ENV_DEFAULT)))
+		env_save();
+#endif
+
+	/*
+	 * Done last and only in RAM (after any env_save above), so a held
+	 * button changes just this boot and is never persisted: run the
+	 * network autoinstall instead of the normal boot.
+	 */
+	if (install_button_held()) {
+		printf("reset/WPS button held - starting network autoinstall\n");
+		env_set("bootcmd", "run autoinstall");
+	}
+
+	return 0;
+}
