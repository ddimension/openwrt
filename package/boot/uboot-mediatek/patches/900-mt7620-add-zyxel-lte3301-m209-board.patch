--- a/board/mediatek/mt7620-lte3301-m209/mt7620-lte3301-m209-autoinstall.env
+++ b/board/mediatek/mt7620-lte3301-m209/mt7620-lte3301-m209-autoinstall.env
@@ -0,0 +1,30 @@
+bootdelay=3
+baudrate=115200
+bootcmd=run autoinstall
+bootargs=console=ttyS0,115200 rootfstype=squashfs
+
+loadaddr=0x80010000
+netloadaddr=0x81000000
+
+# Sanity magics checked before any flash erase/write (see chk_* below):
+#   spl_magic = first word of the bootloader (SPL entry, offset 0)
+#   fit_magic = FDT/FIT magic d00dfeed, little-endian in memory
+# A download is only written if it is the right kind of image; tftpboot
+# already guarantees the transfer was complete (it fails otherwise).
+spl_magic=1000013f
+fit_magic=edfe0dd0
+chk_factory=test "$filesize" = "ff0000" && setexpr v *$netloadaddr + 0 && test "$v" = "$spl_magic" && setexpr a $netloadaddr + 0x40000 && setexpr v *$a + 0 && test "$v" = "$fit_magic"
+
+# Fixed recovery LAN, fully static - no DHCP/BOOTP anywhere.
+ipaddr=192.168.123.254
+serverip=192.168.123.123
+
+# One-shot full-image install: fetch factory.bin over TFTP, write the
+# complete flash image (U-Boot + env + firmware; the config partition
+# at 0xFF0000 is not part of it) and reset. There is no read-back
+# verify: the 16 MiB image leaves no free RAM window for a second
+# copy (the relocation area is reserved); the sf update skip-identical
+# logic plus the FIT hash checks on the next boot guard against torn
+# writes. Runs from RAM, so jboot stays intact until the write reaches
+# the bootloader sectors.
+autoinstall=tftpboot $netloadaddr factory.bin && run chk_factory && sf probe && sf update $netloadaddr 0x0 $filesize && reset || echo "autoinstall: image incomplete or not a bootloader - flash skipped"
